<?xml version="1.0"?>
<robot name="drawing_arm">

  <!--creating different coloured materials-->>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="arm_blue">
    <color rgba="0.15 0.45 0.85 0.95"/>
  </material>
  <material name="arm_orange">
    <color rgba="0.90 0.45 0.15 0.95"/>
  </material>
  <material name="joint_silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="pen_red">
    <color rgba="0.9 0.1 0.1 1.0"/>
  </material>

  <!-- base link at the origin -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.01"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>



  <joint name="left_shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_upper_arm"/>
    <origin xyz="0 0 0.018" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="10.0"/>
  </joint>

  <link name="left_upper_arm">
    <!-- link bar -->
    <visual>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.02 0.006"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>
    <!-- shoulder hub -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.008"/>
      </geometry>
      <material name="joint_silver"/>
    </visual>
  </link>

  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_upper_arm"/>
    <child link="left_forearm"/>
    <origin xyz="0.18 0 0.008" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="10.0"/>
  </joint>

  <link name="left_forearm">
    <!-- link bar -->
    <visual>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.018 0.006"/>
      </geometry>
      <material name="arm_blue"/>
    </visual>
    <!-- elbow hub -->
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.018"/>
      </geometry>
      <material name="joint_silver"/>
    </visual>
  </link>

  
  <joint name="pen_tip_joint" type="fixed">
    <parent link="left_forearm"/>
    <child link="pen_tip"/>
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
  </joint>

  <link name="pen_tip">
    <visual>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.03"/>
      </geometry>
      <material name="pen_red"/>
    </visual>
  </link>

 

  
  <joint name="right_shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_upper_arm"/>
    <origin xyz="0 0 0.023" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="10.0"/>
  </joint>

  <link name="right_upper_arm">
    <!-- link bar -->
    <visual>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.02 0.006"/>
      </geometry>
      <material name="arm_orange"/>
    </visual>
    <!-- Shoulder hub -->
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.018"/>
      </geometry>
      <material name="joint_silver"/>
    </visual>
  </link>

  
  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_upper_arm"/>
    <child link="right_forearm"/>
    <origin xyz="0.18 0 -0.008" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="10.0"/>
  </joint>

  <link name="right_forearm">
    <!-- link bar -->
    <visual>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.018 0.006"/>
      </geometry>
      <material name="arm_orange"/>
    </visual>
    <!-- elbow hub -->
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.018"/>
      </geometry>
      <material name="joint_silver"/>
    </visual>
  </link>

</robot>